model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String
  service        String
  message        String
  submittedAt    DateTime   @default(now())
  status         LeadStatus @default(NEW)

  priority       Priority   @default(MEDIUM)
  notes          String?
  followUpDate   DateTime?
  tags           String[]   @default([])
  estimatedValue Float?

  assignedToId   Int?
  assignedTo     User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([submittedAt])
  @@index([email])
  @@index([assignedToId])
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
