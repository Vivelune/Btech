generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  username  String?  @unique
  clerkId   String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  @@index([email])
}

enum Role {
  ADMIN
  USER
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  service     String
  message     String
  submittedAt DateTime   @default(now())
  status      LeadStatus @default(NEW)

  @@index([status])
  @@index([submittedAt])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  ARCHIVED
}
