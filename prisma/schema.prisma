generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String?
  username      String?  @unique
  clerkId       String   @unique
  role          Role     @default(USER)
  createdAt     DateTime @default(now())

  assignedLeads Lead[]     @relation("LeadAssignee")
  sentEmails    Email[]
  activities    Activity[]

  @@index([email])
}

enum Role {
  ADMIN
  USER
  SALES_REP
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String
  company        String?
  phone          String?
  website        String?
  service        String?
  message        String
  submittedAt    DateTime   @default(now())
  status         LeadStatus @default(NEW)

  priority       Priority   @default(MEDIUM)
  notes          String?
  followUpDate   DateTime?
  tags           String[]   @default([])
  estimatedValue Float?

  assignedToId   Int?
  assignedTo     User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])

  emails         Email[]
  activities     Activity[]

  @@index([status])
  @@index([submittedAt])
  @@index([email])
  @@index([assignedToId])
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  MEETING_BOOKED
  QUALIFIED
  CONVERTED
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Email {
  id          String      @id @default(cuid())
  leadId      String
  lead        Lead        @relation(fields: [leadId], references: [id])

  sentById    Int?
  sentBy      User?       @relation(fields: [sentById], references: [id])

  subject     String
  body        String
  status      EmailStatus @default(QUEUED)

  // Resend's message id — how incoming webhooks get correlated back to
  // this row (Delivered/Opened/Bounced events reference it, not our id).
  providerId  String?     @unique

  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  bouncedAt   DateTime?
  repliedAt   DateTime?

  createdAt   DateTime    @default(now())

  @@index([leadId])
  @@index([sentById])
  @@index([status])
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  REPLIED
  FAILED
}

// A role pre-registered by an admin for an email that hasn't signed up
// yet (Account Management "Create Account"). Consumed and deleted the
// moment that email actually creates a User row — see
// lib/pendingRole.ts, lib/getCurrentUser.ts, and the Clerk webhook.
model PendingRoleAssignment {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])

  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])

  // Kept as a plain string rather than an enum: activity types will
  // likely grow (status_change, note_added, email_sent, assigned,
  // priority_changed, ai_email_generated, ...) and a string avoids a
  // migration every time a new one is added. Validate against a known
  // list in application code instead.
  type      String
  detail    String?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}
